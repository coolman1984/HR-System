{
  "$id": "https://eco.local/contracts/hr.payroll_period.v1.schema.json",
  "title": "hr.payroll_period.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "app",
        "type",
        "key"
      ]
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "run": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "const": "EGP"
    },
    "pay_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "reversed"
      ]
    },
    "lines": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cost_center": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "account_key": {
            "type": "string",
            "enum": [
              "gross_earnings",
              "overtime",
              "night_allowance",
              "employer_social_insurance",
              "agency_labour",
              "employee_social_insurance",
              "salary_tax",
              "other_deductions",
              "net_payable"
            ]
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "cost_center",
          "account_key",
          "amount_minor"
        ]
      }
    },
    "headcount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hours": {
      "type": "object",
      "properties": {
        "regular": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overtime_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overtime_night": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "regular",
        "overtime_day",
        "overtime_night"
      ]
    }
  },
  "required": [
    "id",
    "code",
    "version",
    "origin",
    "period",
    "run",
    "currency",
    "pay_date",
    "status",
    "lines",
    "headcount",
    "hours"
  ]
}
