{
  "$id": "https://eco.local/contracts/mes.labor_day.v1.schema.json",
  "title": "mes.labor_day.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "app",
        "type",
        "key"
      ]
    },
    "employee": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "production_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "shift": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entries": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "station": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          }
        },
        "required": [
          "line",
          "minutes"
        ]
      }
    },
    "total_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    }
  },
  "required": [
    "id",
    "version",
    "origin",
    "employee",
    "production_date",
    "entries",
    "total_minutes"
  ]
}
