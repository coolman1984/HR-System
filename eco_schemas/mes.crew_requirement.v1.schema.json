{
  "$id": "https://eco.local/contracts/mes.crew_requirement.v1.schema.json",
  "title": "mes.crew_requirement.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "shift": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "work_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "headcount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "skills": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "skill_code",
          "level",
          "count"
        ]
      }
    },
    "mrp_run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "app",
        "type",
        "key"
      ]
    }
  },
  "required": [
    "id",
    "line",
    "shift",
    "work_date",
    "headcount",
    "skills",
    "mrp_run",
    "version",
    "origin"
  ]
}
